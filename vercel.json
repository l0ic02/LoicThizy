{
  "redirects": [
    {
      "source": "/",
      "destination": "https://l0ic02.github.io/",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "https://l0ic02.github.io/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/mirror.mjs": {
      "maxDuration": 60
    }
  }
}
